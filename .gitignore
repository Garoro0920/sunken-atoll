# Godot 4 imported assets cache
.godot/

# Godot translation binaries (auto-generated from .csv)
*.translation

# Editor addons (each contributor installs the version pinned in
# docs/02_services/version_policy.md §9.1; CI downloads its own copy
# via the gdunit4-action input). See pipeline/decisions/2026-05-05_gdunit4_version_correction.md
# for adoption strategy follow-up.
addons/

# Mono / .NET artifacts (only relevant if C# is adopted)
.mono/
data_*/
*.csproj.user
mono_crash.*.json

# Local export credentials (must never be committed)
export_credentials.cfg

# CI / build outputs (per docs/01_architecture/directory_structure.md §5)
build/

# Local outputs from headless Godot import & test runs (N-02 / GdUnit4 local).
# CI generates these inside its runner, so they should never be committed.
import.log
import_first.log
import*.log
reports/

# Local secrets and environment overrides (per docs/02_services/secrets_management.md)
.env
.env.local
.envrc

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editor state
.idea/
.vscode/
*.swp
*~

# Backup / temp files
*.bak
*.tmp
*.import.bak

# Python venvs (if pipeline scripts use Python)
.venv/
__pycache__/
*.pyc

# Node dependencies (if MCP or distribution scripts use Node)
node_modules/
.pnp.*
