# Environment variables template.
#
# Copy this file to `.env` and fill in actual values for your local development.
# `.env` is git-ignored. NEVER commit real secrets.
#
# See docs/02_services/secrets_management.md for the authoritative naming list,
# rotation policy, and storage locations.

# --- Orchestration / LLM ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 3D mesh generation ---
TRIPO_API_KEY=
MESHY_API_KEY=

# --- Texture / image generation ---
STABILITY_API_KEY=

# --- Audio (BGM / SFX / TTS) ---
ELEVENLABS_API_KEY=
AIVA_API_KEY=

# --- Animation / mocap ---
DEEPMOTION_API_KEY=

# --- NPC AI runtime ---
INWORLD_API_KEY=

# --- Environment / HDRI ---
BLOCKADE_API_KEY=

# --- Asset libraries ---
SKETCHFAB_API_TOKEN=

# --- Multiplayer backend (selected at version_policy lock-in) ---
NAKAMA_SERVER_KEY=

# --- Monitoring ---
SENTRY_AUTH_TOKEN=

# --- Distribution (used only by CI release jobs, not local dev) ---
# STEAM_USERNAME=
# STEAM_PASSWORD=
# STEAM_GUARD_CODE=

# --- Pipeline behavior ---
DRY_RUN=true
