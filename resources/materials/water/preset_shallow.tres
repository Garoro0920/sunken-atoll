[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[ext_resource type="Shader" path="res://resources/shaders/water/water_surface.gdshader" id="1_shader"]

[resource]
shader = ExtResource("1_shader")
; Tone-down pass after the demo flagged the previous values as
; "全体的に明るすぎる". Albedo (deep/shallow) lowered ~50%, roughness
; raised slightly to soften specular highlights, fresnel softened a
; touch so glancing-angle rims are less blown out. The relative
; deep-vs-shallow contrast is preserved so the depth fade still reads.
shader_parameter/deep_color = Color(0.04, 0.18, 0.25, 1.0)
shader_parameter/shallow_color = Color(0.20, 0.45, 0.52, 0.85)
shader_parameter/depth_fade_distance = 4.0
shader_parameter/roughness_base = 0.10
shader_parameter/metallic_base = 0.0
shader_parameter/fresnel_power = 4.0
shader_parameter/foam_color = Color(0.85, 0.88, 0.90, 1.0)
shader_parameter/foam_distance = 0.7
shader_parameter/foam_noise_scale = 4.0
shader_parameter/wave_dir_a = Vector2(1.0, 0.0)
shader_parameter/wave_dir_b = Vector2(0.7, 0.7)
shader_parameter/wave_dir_c = Vector2(-0.3, 0.95)
shader_parameter/wave_amplitude_a = 0.15
shader_parameter/wave_amplitude_b = 0.10
shader_parameter/wave_amplitude_c = 0.05
shader_parameter/wave_length_a = 6.0
shader_parameter/wave_length_b = 4.0
shader_parameter/wave_length_c = 2.5
shader_parameter/wave_steepness = 0.4
shader_parameter/storm_intensity = 0.0
