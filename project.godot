; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sunken Atoll"
config/description="Cooperative multiplayer survival in a flooded world. See specs/game_design_document.md."
run/main_scene="res://scenes/levels/stranding/stranding_demo.tscn"
config/features=PackedStringArray("4.6")

[autoload]

WorldClock="*res://src/core/world/time_of_day.gd"
WorldWeather="*res://src/core/world/weather.gd"
InputMapBootstrap="*res://src/core/input_map_bootstrap.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[rendering]

; Switch to the Compatibility (OpenGL 3.3) backend. Forward+ on the
; reporter's NVIDIA driver was producing reproducible full-screen
; flicker that survived sky / glow / shadow / shader simplification;
; the symptom is consistent with known Forward+ driver-interaction
; issues. Compatibility renders a less feature-rich pipeline but
; is significantly more stable across driver versions and is the
; recommended fallback for desktops affected by Forward+ regressions.
; Re-evaluate switching back when Sprint 2 water polish arrives.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
