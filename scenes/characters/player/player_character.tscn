[node name="Camera3D" type="Camera3D" parent="."]
; First-person camera. Positioned at local (0, 0.6, 0) — eye height
; inside the capsule (radius 0.4, height 1.8 centered on player origin).
; Camera near plane (0.1) is closer than the capsule wall (0.4) and the
; capsule mesh is back-face culled, so the camera sees through it.
; Identity basis: looks at -Z initially; mouse-look pitches the camera
; around its local X (PlayerCharacter.apply_mouse_look) and yaws the
; whole player around world Y.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.6, 0)
current = true
fov = 75.0
near = 0.1
far = 500.0
