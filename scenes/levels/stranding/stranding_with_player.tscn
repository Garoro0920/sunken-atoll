[gd_scene load_steps=6 format=3]

; Bisect step 2: stranding_minimal + Player instance.
;
; If this scene shows the orange island, the Player instance is fine
; in isolation and the bug is in WaterMesh / DemoHud / BuildingPlacement
; (test the next step).
;
; If this scene shows ONLY sky-blue, the Player instance is the issue
; — most likely the player Camera3D's `current=true` competing with
; DemoCamera and "winning" with a transform that ends up looking at
; nothing.

[ext_resource type="PackedScene" path="res://scenes/characters/player/player_character.tscn" id="1_player"]

[sub_resource type="Environment" id="Environment_min"]
background_mode = 1
background_color = Color(0.55, 0.7, 0.85, 1)
ambient_light_source = 2
ambient_light_color = Color(0.85, 0.87, 0.92, 1)
ambient_light_energy = 0.7
tonemap_mode = 0
glow_enabled = false

[sub_resource type="BoxMesh" id="BoxMesh_island"]
size = Vector3(8, 1, 8)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_island"]
albedo_color = Color(1, 0.5, 0.1, 1)
shading_mode = 0
metallic = 0.0
roughness = 1.0

[sub_resource type="BoxShape3D" id="BoxShape3D_island"]
size = Vector3(8, 1, 8)

[node name="StrandingWithPlayer" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_min")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.707107, -0.707107, 0, 0.707107, 0.707107, 0, 30, 0)
light_energy = 1.5
shadow_enabled = false

[node name="Island" type="StaticBody3D" parent="."]

[node name="IslandMesh" type="MeshInstance3D" parent="Island"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
mesh = SubResource("BoxMesh_island")
material_override = SubResource("StandardMaterial3D_island")

[node name="IslandCollider" type="CollisionShape3D" parent="Island"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
shape = SubResource("BoxShape3D_island")

[node name="Player" parent="." instance=ExtResource("1_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.0, 0)

[node name="Camera3D" type="Camera3D" parent="."]
; Identity-basis camera at (0, 4, 15) - same as stranding_minimal.
; current=true, but Player's Camera3D is ALSO current=true. If Godot
; picks the player's, the camera ends up at world (0, 6, 7) looking
; 30 deg down — should still see the island.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 4, 15)
current = true
fov = 70.0
near = 0.1
far = 500.0
