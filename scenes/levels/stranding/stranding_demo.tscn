[gd_scene load_steps=15 format=3]

[ext_resource type="Script" path="res://scenes/levels/stranding/stranding_demo.gd" id="1_demo"]
[ext_resource type="PackedScene" path="res://scenes/characters/player/player_character.tscn" id="2_player"]
[ext_resource type="Script" path="res://src/gameplay/building/building_placement.gd" id="3_placement"]
