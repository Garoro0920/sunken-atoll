[ext_resource type="Script" path="res://scenes/prototypes/floating/water_field.gd" id="5_field"]
[ext_resource type="Script" path="res://scenes/levels/stranding/demo_hud.gd" id="8_hud"]

[sub_resource type="Environment" id="Environment_main"]
; Solid colour background. The procedural sky was disabled in the
; flicker investigation because procedural sky + sun + glow combine
; into per-frame temporal noise on the Compatibility renderer. A
; richer environment will return in Sprint 2 once the water shader
; and post-processing path are hardened.
background_mode = 1
background_color = Color(0.55, 0.7, 0.85, 1)
; ambient_light_source = 2 means COLOR (constant ambient). The previous
; value 1 means DISABLED, which is why nothing rendered after the
; renderer switch — the corrected sun direction provided directional
; lighting only on +Y-facing faces, but with no ambient those faces
; combined with an undersized energy still rendered close to background.
ambient_light_source = 2
ambient_light_color = Color(0.85, 0.87, 0.92, 1)
ambient_light_energy = 0.7
tonemap_mode = 0
glow_enabled = false

[sub_resource type="PlaneMesh" id="PlaneMesh_water"]
size = Vector2(200, 200)
subdivide_width = 8
subdivide_depth = 8

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_water"]
; Plain opaque water for the Sprint 1 demo. The custom Gerstner-wave
; shader (resources/shaders/water/water_surface.gdshader) had transparency
; + DEPTH_TEXTURE-based depth fade that interacted poorly with Forward+
; rendering, surfacing as full-screen flicker. The shader is preserved
; for the prototype and for Sprint 2's water polish work; the demo uses
; this simple material until the shader path is hardened.
albedo_color = Color(0.18, 0.42, 0.55, 1)
metallic = 0.0
roughness = 0.45

[sub_resource type="BoxMesh" id="BoxMesh_island"]
size = Vector3(8, 1, 8)

[sub_resource type="BoxShape3D" id="BoxShape3D_island"]
size = Vector3(8, 1, 8)

[node name="StrandingDemo" type="Node3D"]
script = ExtResource("1_demo")
auto_grant_starter = true

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_main")

[node name="Sun" type="DirectionalLight3D" parent="."]
; Pitched 45 degrees down (north-tilted). Light direction = -basis.z =
; (0, -0.707, -0.707), so it shines from above and slightly toward -Z,
; lighting the +Y faces of every object in the scene. The previous
; transform's basis.z component pushed light *upward* — combined with
; ambient_light_source = DISABLED, that left the entire scene unlit
; and indistinguishable from the sky-blue background.
transform = Transform3D(1, 0, 0, 0, 0.707107, -0.707107, 0, 0.707107, 0.707107, 0, 30, 0)
light_energy = 1.5
; Real-time directional shadows are a known per-frame jitter source
; on Compatibility renderer + small geometry; disabled for the demo.
shadow_enabled = false

[node name="WaterField" type="Node" parent="."]
script = ExtResource("5_field")

[node name="WaterMesh" type="MeshInstance3D" parent="."]
; Lowered to y=-0.5 (was -0.1). With the island top at y=0 and the box
; physics depth tolerance, anything within ~0.2 m of the island top can
; still surface flicker artifacts when the camera rakes the horizon.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
mesh = SubResource("PlaneMesh_water")
material_override = SubResource("StandardMaterial3D_water")

[node name="Island" type="StaticBody3D" parent="."]

[node name="IslandMesh" type="MeshInstance3D" parent="Island"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
mesh = SubResource("BoxMesh_island")

[node name="IslandCollider" type="CollisionShape3D" parent="Island"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
shape = SubResource("BoxShape3D_island")

[node name="Player" parent="." instance=ExtResource("2_player")]
